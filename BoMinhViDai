remoteScript = remoteScript:gsub("isVerified = false", "isVerified = true")
loadstring(remoteScript)()
-- Xóa bảng key thừa từ script gốc (nếu có)
pcall(function()
	local pg = player:WaitForChild("PlayerGui")
	local old = pg:FindFirstChild("BoMinhKeySystem")
	if old then old:Destroy() end
end)
